---
import type { GetStaticPaths } from "astro"
import { getCollection, render } from "astro:content"

import BaseLayout from "../../layouts/BaseLayout.astro"
import { noteHref, noteSlug, visibleNotes } from "../../lib/notes"

export const getStaticPaths = (async () => {
  const notes = visibleNotes(await getCollection("notes"))
  const pageNotes = notes.filter((note) => noteSlug(note) !== "home")
  const slugs = new Set<string>()

  return pageNotes.map((note, index) => {
    const slug = noteSlug(note)
    if (slugs.has(slug)) throw new Error(`筆記 slug 重複：${slug}`)
    slugs.add(slug)
    return {
      params: { slug },
      props: {
        note,
        previousNote: pageNotes[index - 1],
        nextNote: pageNotes[index + 1],
      },
    }
  })
}) satisfies GetStaticPaths

const { note, previousNote, nextNote } = Astro.props
const { Content } = await render(note)
const base = import.meta.env.BASE_URL.replace(/\/$/, "")
---

<BaseLayout title={note.data.title} description={note.data.description}>
  <header class="note-header">
    <h1>{note.data.title}</h1>
    {
      note.data.tags.length > 0 && (
        <div class="tags" aria-label="標籤">
          {note.data.tags.map((tag: string) => <span>#{tag}</span>)}
        </div>
      )
    }
  </header>
  <Content />
  {
    (previousNote || nextNote) && (
      <nav class="note-pagination" aria-label="文章導覽">
        {previousNote && (
          <a
            class="note-pagination-link note-pagination-link--previous"
            href={noteHref(previousNote, base)}
            rel="prev"
          >
            <span class="note-pagination-direction">
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="m12.5 5-5 5 5 5" />
              </svg>
              上一篇
            </span>
            <span class="note-pagination-title">{previousNote.data.title}</span>
          </a>
        )}
        {nextNote && (
          <a
            class="note-pagination-link note-pagination-link--next"
            href={noteHref(nextNote, base)}
            rel="next"
          >
            <span class="note-pagination-direction">
              下一篇
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="m7.5 5 5 5-5 5" />
              </svg>
            </span>
            <span class="note-pagination-title">{nextNote.data.title}</span>
          </a>
        )}
      </nav>
    )
  }
</BaseLayout>
