---
import type { CollectionEntry } from "astro:content"

import { noteHref, noteSlug } from "../lib/notes"

interface Props {
  notes: CollectionEntry<"notes">[]
  currentPath: string
}

const { notes, currentPath } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, "")
const sidebarNotes = notes.filter((note) => noteSlug(note) !== "home")
---

<aside class="sidebar" id="sidebar">
  <div class="sidebar-inner">
    <header class="sidebar-header">
      <a class="workspace" href={`${base}/`} aria-label="回到首頁">
        <span class="workspace-mark" aria-hidden="true">P</span>
        <span class="workspace-name">個人學習筆記</span>
      </a>
      <button class="sidebar-toggle" id="sidebar-toggle" type="button" aria-label="收合筆記列表">
        <svg viewBox="0 0 20 20" aria-hidden="true">
          <rect x="3" y="3" width="14" height="14" rx="3"></rect>
          <path d="M8 4v12M12.5 7.5 10 10l2.5 2.5"></path>
        </svg>
      </button>
    </header>
    <nav class="note-navigation" aria-label="筆記列表">
      <div class="navigation-label">筆記</div>
      <ul>
        {
          sidebarNotes.map((note) => {
            const href = noteHref(note, base)
            const active = decodeURI(currentPath) === decodeURI(href)
            return (
              <li>
                <a href={href} aria-current={active ? "page" : undefined}>
                  <svg viewBox="0 0 20 20" aria-hidden="true">
                    <path d="M5 3.5h7l3 3V16a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V4.5a1 1 0 0 1 1-1Z" />
                    <path d="M12 3.5V7h3" />
                  </svg>
                  <span>{note.data.title}</span>
                </a>
              </li>
            )
          })
        }
      </ul>
    </nav>
  </div>
</aside>
